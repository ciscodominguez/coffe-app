DB_HOST=localhost
DB_PORT=3306
DB_NAME=cofe_app
DB_USERNAME=cofe_user
DB_PASSWORD=cofe_password

# JWT — generar un valor real con: openssl rand -base64 48
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
# Formato aceptado por java.time.Duration/spring — ver JwtProperties: "8h", "60m", "30s".
JWT_EXPIRES_IN=8h

# CORS (origen del frontend Angular)
CORS_ORIGIN=http://localhost:4200

PORT=3000

# Imágenes de producto (ver media/FileStorageService). UPLOADS_DIR es la
# carpeta en disco donde se guardan — creála (o dejá que se cree sola al
# bootear) y agregala a tu .gitignore. PUBLIC_BASE_URL es con qué host se
# arma la URL pública de cada imagen: por defecto el mismo que apiBaseUrl
# en el frontend, con /api/v1 incluido.
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000/api/v1

# Link de "Olvidé mi contraseña" (V9): dirección del frontend.
FRONTEND_URL=http://localhost:4200

# Correo (V9). SIN esto el backend funciona igual: los mails (por ejemplo,
# el link para restablecer la contraseña) se escriben en el log del backend
# en vez de enviarse — sirve para probar. Para enviarlos de verdad,
# descomentá y completá un servidor SMTP. Ejemplo con Gmail (necesita una
# "contraseña de aplicación" de Google, no la contraseña normal):
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=tu-cuenta@gmail.com
# spring.mail.password=la-contraseña-de-aplicacion
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
MAIL_FROM=COFFE_APP <no-responder@coffeapp.local>

# Cobros con QR de Mercado Pago (paso 2.2 del README).
# Frase para cifrar los Access Token guardados (minimo 16 caracteres).
# En produccion: una propia, larga y al azar. Si se cambia, cada cafe
# tiene que volver a conectar Mercado Pago.
MP_TOKEN_ENCRYPTION_KEY=reemplazar-por-otra-frase-larga-y-aleatoria-para-cifrar-tokens
# Opcionales: minutos hasta que vence un QR (1 a 15) y cada cuanto se
# revisan los cobros pendientes (milisegundos).
# MP_QR_EXPIRATION_MINUTES=15
# MP_SYNC_INTERVAL_MS=15000

# Panel de superadmin (paso 3.1 del README): la cuenta de Fran para ver
# todos los cafés, suspenderlos o cambiarles el plan. Se crea sola al
# arrancar. La contraseña tiene que tener al menos 10 caracteres; si la
# cambiás acá, se actualiza al reiniciar. NO uses el mismo email que tu
# usuario de dueño de un café. Sin estas dos líneas no hay panel.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# A quién llamar: se muestra cuando un café suspendido quiere entrar.
# Ej: Fran por WhatsApp al 223 555-0000
SUPPORT_CONTACT=

# Cobro de la suscripción (paso 3.2 del README): Access Token de TU cuenta
# de Mercado Pago (donde entra la plata de los abonos de los cafés).
# Credenciales de producción -> "APP_USR-...". Vacío = nadie puede
# suscribirse todavía (la prueba gratis y los avisos andan igual).
BILLING_MP_ACCESS_TOKEN=

# Versión vigente de los Términos y la Política de privacidad (paso 3.3 del
# README). Tiene que ser igual a "version" en
# frontend/src/app/features/legal/legal-info.ts. Si la cambiás, a cada
# dueño le aparece para aceptarla de nuevo. Vacío = 2026-10-01.
# LEGAL_VERSION=2026-10-01
