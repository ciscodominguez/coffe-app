# COFFE_APP — configuración del SERVIDOR (deploy/.env).
#
# scripts/instalar.sh copia este archivo a .env y completa solo las claves
# al azar (las que dicen "se genera sola"). Lo demás lo completás vos.
# NUNCA subas el .env a GitHub ni se lo mandes a nadie.

# ---------------------------------------------------------------- Dominio
# El dominio de la app, sin https:// (tiene que apuntar a la IP del servidor).
DOMINIO=app.tudominio.com.ar

# ------------------------------------------------------- Claves (se generan solas)
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
# OJO: si se cambia, cada café tiene que volver a conectar Mercado Pago.
MP_TOKEN_ENCRYPTION_KEY=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------- Tu panel
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Ej: Fran por WhatsApp al 223 555-0000
SUPPORT_CONTACT=

# ------------------------------------------------- Mercado Pago (suscripciones)
# Access Token de producción de TU cuenta (APP_USR-...). Vacío = nadie puede suscribirse.
BILLING_MP_ACCESS_TOKEN=

# ---------------------------------------------------------------- Correo
MAIL_FROM=COFFE_APP <no-responder@tudominio.com.ar>
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=tu-cuenta@gmail.com
# spring.mail.password=la-contraseña-de-aplicacion
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true

# -------------------------------------------------------- Memoria (2 GB)
# Java como máximo 768 MB, así no le saca la RAM a MySQL.
JAVA_OPTS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=200m -XX:+ExitOnOutOfMemoryError
MYSQL_BUFFER=256M

# ------------------------------------------------------ Copias de seguridad
# Adónde se mandan las copias, con rclone (ver docs/SERVIDOR.md, paso 4).
# Formato "nombre-del-remoto:carpeta". Ej: b2:cofe-backups  r2:cofe-backups  gdrive:cofe-backups
BACKUP_DESTINO=
# Cuántos días se guardan afuera del servidor.
BACKUP_DIAS=14

# ---------------------------------------------------------------- Avisos
# Te llegan al celular con la app gratuita "ntfy" (ntfy.sh): instalala y
# suscribite a este tema. Elegí un nombre difícil de adivinar.
AVISOS_NTFY_TEMA=
# Porcentaje de disco a partir del cual te avisa.
AVISO_DISCO_PORCENTAJE=80

# ------------------------------------------------- Ventana de actualización
# Días permitidos (1 = lunes ... 7 = domingo) y horario: después del cierre.
# Por defecto: noches de lunes a jueves, de 23 a 6.
ACTUALIZAR_DIAS=1-4
ACTUALIZAR_DESDE=23
ACTUALIZAR_HASTA=6
